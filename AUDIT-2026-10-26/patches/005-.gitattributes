# AUDIT 2026-10-26: LFS-политика для бинарных артефактов (на НОВЫЕ файлы;
# исторические блобы - через git-lfs migrate import, см. AUDIT-REPORT.md)
*.cab   filter=lfs diff=lfs merge=lfs -text
*.zip   filter=lfs diff=lfs merge=lfs -text
*.7z    filter=lfs diff=lfs merge=lfs -text
*.msi   filter=lfs diff=lfs merge=lfs -text
*.exe   filter=lfs diff=lfs merge=lfs -text
*.iso   filter=lfs diff=lfs merge=lfs -text
*.wim   filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.docx  filter=lfs diff=lfs merge=lfs -text
*.cer   filter=lfs diff=lfs merge=lfs -text
*.part* filter=lfs diff=lfs merge=lfs -text
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.xml   text eol=crlf
